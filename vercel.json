{
  "buildCommand": "cd jarvis-frontend && npm run build",
  "outputDirectory": "jarvis-frontend/dist",
  "installCommand": "cd jarvis-frontend && npm install",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://jarvis-backend-h38f.onrender.com/api/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}